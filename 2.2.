# выполнение п.2.2. "изобразить ассиметричный роутинг"
# ассиметричный роутинг - это когда пакет до сервера идёт одним маршрутом
# а обратно другим машрутом
# в OSPF это достигается за счет указания стоимости интерфейса через переменную Cost
# изначально её значение 100, которое будет изменяться на 1000, т.е. станет дорогим
# с роутера 1 будем делать пинг до сети2 с интерфейсом 192.168.20.1

# Есть только одна особенность в ядре линукса, которая не даст нормально выполнить команду пинг
# она заключется в том, что если пакет пришел не с того интерфейса с которого был отправлен,
# то он отбрасывается. Т.е. отбросится если переменная rp_filter у интрерфейса имеет значение не 0.
# изменю изначальное значение 1 на 0 для двух интерфейсов роутера 1.
[vagrant@router1 ~]$ cat /proc/sys/net/ipv4/conf/eth2/rp_filter
1
[vagrant@router1 ~]$ cat /proc/sys/net/ipv4/conf/eth3/rp_filter
1
[vagrant@router1 ~]$ sudo sysctl -w net.ipv4.conf.eth2.rp_filter=0
net.ipv4.conf.eth2.rp_filter = 0
[vagrant@router1 ~]$ sudo sysctl -w net.ipv4.conf.eth3.rp_filter=0
net.ipv4.conf.eth3.rp_filter = 0
[vagrant@router1 ~]$ cat /proc/sys/net/ipv4/conf/eth2/rp_filter
0
[vagrant@router1 ~]$ cat /proc/sys/net/ipv4/conf/eth3/rp_filter
0
[vagrant@router1 ~]$ # теперь пакет не будет отбрасываться, если пришёл с другого интерфейса, а не с того, с которого был отправлен

# изначально стоимость интерфейсов 2 и 3 на роутере1 = 100
[vagrant@router1 ~]$ sudo vtysh -c "show ip ospf interface eth2" | grep Cost
  Router ID 1.1.1.1, Network Type BROADCAST, Cost: 100
[vagrant@router1 ~]$ sudo vtysh -c "show ip ospf interface eth3" | grep Cost
  Router ID 1.1.1.1, Network Type BROADCAST, Cost: 100

# при одинаковой стоимости = 100 интерфейсов 2 и 3 видно, что маршруты до сети3 идёт через интерфейс 3
